<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

  <Script file="setup.lua" />
  <Script file="speech.lua" />
  <Script file="QuestLog.lua" />
  <Script file="talents.lua" />
  <Script file="spellbook.lua" />
  <Script file="tradeskill.lua" />
  <Script file="craft.lua" />
  <Script file="petStable.lua" />
  <Include file="character\modules.xml" />
  <Script file="lfg.lua" />
  <Script file="socketing.lua" />
  <Include file="auction\modules.xml" />
  <!-- The surroundings (camelot/surroundings, the same module as on WoW:
       Forever) with this client's data: the tbc folder of the
       WowVision_Surroundings repository, exported from TBC Anniversary. -->
  <Include file="..\camelot\surroundings\modules.xml" />
  <!-- packed for the game by tools/surroundings-pack.py (generated, git-ignored; run it after every export
       and after updating the data submodule) -->
  <Include file="..\mapdata\WowVision_SurroundingsPacked\tbc\data.xml" />
  <!-- LOCAL TRIAL ONLY (local-play, never in a PR): the WowNav routes with
       Broesel's WoW: Forever data, to test the system on TBC until a TBC
       export exists. The cities are other models on Forever: a route may
       get stuck there. -->
  <Include file="..\camelot\wownav\modules.xml" />
  <Include file="..\mapdata\WowNavPacked\data.xml" />
  <!-- what the player bumps into (core/navigation/bumps.lua), written by tools/bumps-pack.lua -->
  <Include file="..\mapdata\bumps\tbc\data.xml" />

</Ui>
